{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customGradient": false,
			"customDuotone": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "red",
					"name": "Tresundios red",
					"color": "#c74634"
				},
				{
					"slug": "red-deep",
					"name": "Red (small text on light)",
					"color": "#b23e2d"
				},
				{
					"slug": "red-bright",
					"name": "Red (small text on dark)",
					"color": "#e46a54"
				},
				{
					"slug": "black",
					"name": "Black",
					"color": "#000000"
				},
				{
					"slug": "ink",
					"name": "Ink",
					"color": "#111111"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#ffffff"
				},
				{
					"slug": "grey-1",
					"name": "Grey 1 (page)",
					"color": "#f2f2f2"
				},
				{
					"slug": "grey-2",
					"name": "Grey 2",
					"color": "#d9d9d9"
				},
				{
					"slug": "grey-3",
					"name": "Grey 3 (decorative only)",
					"color": "#8c8c8c"
				},
				{
					"slug": "grey-4",
					"name": "Grey 4 (muted text)",
					"color": "#4d4d4d"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Archivo Black",
					"fontFamily": "\"Archivo Black\", \"Arial Black\", Impact, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo Black",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo-black.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Archivo",
					"fontFamily": "\"Archivo\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "400 800",
							"fontStretch": "100%",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/archivo.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "\"JetBrains Mono\", ui-monospace, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "500 700",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jetbrains-mono.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "label",
					"name": "Label",
					"size": "12px",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "14px",
					"fluid": false
				},
				{
					"slug": "base",
					"name": "Base",
					"size": "16px",
					"fluid": false
				},
				{
					"slug": "lede",
					"name": "Lede",
					"size": "clamp(16px, 1.6vw, 19px)",
					"fluid": false
				},
				{
					"slug": "h4",
					"name": "H4",
					"size": "clamp(18px, 2vw, 25px)",
					"fluid": false
				},
				{
					"slug": "h3",
					"name": "H3",
					"size": "clamp(22px, 2.4vw, 30px)",
					"fluid": false
				},
				{
					"slug": "h2",
					"name": "H2",
					"size": "clamp(30px, 4.6vw, 58px)",
					"fluid": false
				},
				{
					"slug": "h1",
					"name": "H1",
					"size": "clamp(40px, 7vw, 92px)",
					"fluid": false
				},
				{
					"slug": "giant",
					"name": "Giant",
					"size": "clamp(90px, 13vw, 170px)",
					"fluid": false
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "XS",
					"size": "8px"
				},
				{
					"slug": "20",
					"name": "S",
					"size": "16px"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "24px"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "48px"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "clamp(40px, 5vw, 64px)"
				},
				{
					"slug": "section",
					"name": "Section",
					"size": "clamp(64px, 9vw, 112px)"
				}
			],
			"blockGap": null
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1320px"
		},
		"border": {
			"radius": true,
			"color": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "hard-sm",
					"name": "Hard small",
					"shadow": "3px 3px 0 #000000"
				},
				{
					"slug": "hard",
					"name": "Hard",
					"shadow": "6px 6px 0 #000000"
				},
				{
					"slug": "hard-lg",
					"name": "Hard large",
					"shadow": "10px 10px 0 #000000"
				}
			]
		},
		"custom": {
			"radius": "14px",
			"borderWidth": "3px",
			"gutter": "1rem"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--grey-1)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--custom--gutter)",
				"right": "var(--wp--custom--gutter)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "inherit"
				},
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--red)",
						"style": "solid",
						"width": "3px",
						"offset": "3px"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "400",
					"lineHeight": "1.02",
					"letterSpacing": "-.02em",
					"textTransform": "uppercase"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h1)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h2)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h3)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--h4)"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--red)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "12px",
					"width": "3px",
					"style": "solid",
					"color": "var(--wp--preset--color--black)"
				},
				"shadow": "var(--wp--preset--shadow--hard-sm)",
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "800",
					"fontSize": "15px",
					"lineHeight": "1",
					"textTransform": "uppercase",
					"letterSpacing": ".02em"
				},
				"spacing": {
					"padding": {
						"top": "15px",
						"bottom": "15px",
						"left": "22px",
						"right": "22px"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "cta-book-call",
			"title": "Book a call CTA",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-products",
			"title": "Products overview",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-dentalpin",
			"title": "Product: DentalPin India",
			"postTypes": [ "page" ]
		}
	]
}
